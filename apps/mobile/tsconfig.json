{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["../web/src/*"],
      "vue": ["../web/node_modules/vue"],
      "pinia": ["../web/node_modules/pinia"],
      "vue-router": ["../web/node_modules/vue-router"],
      "@lucide/vue": ["../web/node_modules/@lucide/vue"]
    }
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"]
}
